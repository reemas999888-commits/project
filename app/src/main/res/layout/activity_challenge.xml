<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvChallengeBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← رجوع"
            android:textColor="@color/purple_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="🎯 تحدي اليوم"
            android:textColor="@color/yellow_main"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=" هيا لنختر سوره وننطلق في التحدي !"
            android:textColor="@color/text_dim"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="اختر السورة"
                android:textColor="@color/purple_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSurah"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_counter_box"
                android:padding="10dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="نوع الهدف"
                android:textColor="@color/purple_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoalAyat"
                    android:layout_width="125dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_quick_btn_active"
                    android:gravity="center"
                    android:text="آيات"
                    android:textColor="@color/bg_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalRepetitions"
                    android:layout_width="125dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_quick_btn_inactive"
                    android:gravity="center"
                    android:text="تكرارات"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="عدد الهدف"
                android:textColor="@color/purple_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnGoalMinus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_purple">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="−"
                        android:textColor="@color/yellow_main"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="90dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="@drawable/bg_counter_box"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGoalNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/yellow_main"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoalType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="آيات"
                        android:textColor="@color/text_dim"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnGoalPlus"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_purple">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="+"
                        android:textColor="@color/yellow_main"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnSaveChallenge"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_yellow"
                android:text="حفظ تحدي اليوم"
                android:textColor="@color/bg_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvChallengeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_completion_card"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="22dp"
            android:text="لا يوجد تحدي محفوظ لليوم"
            android:textColor="@color/text_dim"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>