<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:layoutDirection="rtl">
    <!--  🌕 Moon  -->
    <TextView android:id="@+id/tvMoon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌕" android:textSize="55sp" android:layout_marginTop="90dp" android:layout_marginEnd="70dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  🪐 Planet  -->
    <TextView android:id="@+id/tvPlanet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪐" android:textSize="52sp" android:layout_marginTop="80dp" android:layout_marginStart="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <!--  🛸 UFO  -->
    <TextView android:id="@+id/tvUfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛸" android:textSize="46sp" android:layout_marginTop="270dp" android:layout_marginStart="4dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <!--  🚀 Rocket  -->
    <TextView android:id="@+id/tvRocket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚀" android:textSize="46sp" android:layout_marginTop="170dp" android:layout_marginEnd="12dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  🤖 Robot  -->
    <TextView android:id="@+id/tvRobot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="44sp" android:layout_marginTop="370dp" android:layout_marginEnd="10dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  ⭐ Star small decorations  -->
    <TextView android:id="@+id/tvStar1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textSize="12sp" android:textColor="#F5C428" android:layout_marginTop="420dp" android:layout_marginEnd="160dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tvStar2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textSize="8sp" android:textColor="#CCAAFF" android:layout_marginTop="200dp" android:layout_marginStart="80dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tvStar3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:textSize="14sp" android:textColor="#F5C428" android:layout_marginTop="320dp" android:layout_marginEnd="90dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  📖 Book icon circle (centered, upper area)  -->
    <!--  ⭐ mini star  -->
    <FrameLayout
        android:id="@+id/flBookIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_circle_purple_large"
        app:layout_constraintBottom_toTopOf="@id/tvAppTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.758">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📖"
            android:textSize="62sp" />
    </FrameLayout>

    <TextView android:id="@+id/tvMiniStar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐" android:textSize="22sp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/flBookIcon" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  حافظ الصغير Title  -->
    <TextView android:id="@+id/tvAppTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الحافظ الصغير" android:textSize="38sp" android:textColor="@color/yellow_main" android:textStyle="bold" android:layout_marginTop="6dp" app:layout_constraintTop_toBottomOf="@id/tvMiniStar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  هيا نحفظ Subtitle  -->
    <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="هيا نحفظ القرآن معاً!" android:textStyle="bold" android:textSize="18sp" android:textColor="#BBBBDD" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvAppTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  ابدأ الحفظ Button  -->
    <Button android:id="@+id/btnStartHifz" android:layout_width="250dp" android:layout_height="62dp" android:text="📖 ابدأ الحفظ" android:textSize="20sp" android:textColor="#09092B" android:textStyle="bold" android:background="@drawable/bg_button_yellow" android:elevation="4dp" android:layout_marginTop="36dp" app:layout_constraintTop_toBottomOf="@id/tvSubtitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Motivational card  -->
    <!--  Bottom Navigation  -->
    <LinearLayout
        android:id="@+id/cardMotivational"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_motivational_card"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:gravity="end"
            android:text="كل آية تحفظها نجمة في سماء أجرك!"
            android:textColor="@color/white"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="⭐"
            android:textSize="32sp" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@color/nav_bar_bg"
        app:itemIconTint="@drawable/bottom_nav_color"
        app:itemTextColor="@drawable/bottom_nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>