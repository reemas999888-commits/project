<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark" android:layoutDirection="rtl">
    <!--  Header  -->
    <LinearLayout android:id="@+id/llHifzHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="8dp" android:layoutDirection="rtl" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <!--  Gold coin  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪙" android:textSize="26sp"/>
        <!--  Surah name center  -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvHifzSurahName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سورة الفاتحة" android:textSize="22sp" android:textColor="@color/yellow_main" android:textStyle="bold"/>
            <TextView android:id="@+id/tvHifzVerseLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الآية 1 من 5" android:textSize="13sp" android:textColor="@color/text_dim"/>
        </LinearLayout>
        <!--  Close button  -->
        <TextView android:id="@+id/tvHifzClose" android:layout_width="34dp" android:layout_height="34dp" android:text="✕" android:textSize="18sp" android:textColor="@color/white" android:gravity="center" android:background="@drawable/bg_circle_purple_play" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <!--  Progress bar  -->
    <ProgressBar android:id="@+id/progressHifz" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="12dp" android:progressDrawable="@drawable/bg_progress_track" android:progress="10" android:max="100" android:layout_marginHorizontal="16dp" app:layout_constraintTop_toBottomOf="@id/llHifzHeader" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <!--  Progress text row  -->
    <LinearLayout android:id="@+id/llProgressText" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl" android:layout_marginHorizontal="16dp" android:layout_marginTop="4dp" app:layout_constraintTop_toBottomOf="@id/progressHifz" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvProgressVerse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 / 5 آيات" android:textSize="12sp" android:textColor="@color/gray_text"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:id="@+id/tvProgressPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10% مكتمل" android:textSize="12sp" android:textColor="@color/gray_text"/>
    </LinearLayout>
    <!--  Robot decoration (left)  -->
    <TextView android:id="@+id/tvRobotDecor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="34sp" android:layout_marginStart="2dp" app:layout_constraintTop_toBottomOf="@id/llProgressText" app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="6dp"/>
    <!--  Verse card  -->
    <LinearLayout android:id="@+id/llVerseCard" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:background="@drawable/bg_verse_card" android:gravity="center" android:padding="24dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/llProgressText" app:layout_constraintBottom_toTopOf="@id/llRepeatCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVertical_weight="1">
        <!--  Verse number circle  -->
        <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_yellow" android:layout_marginBottom="20dp">
            <TextView android:id="@+id/tvCurrentVerseNum" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="22sp" android:textColor="#09092B" android:textStyle="bold" android:layout_gravity="center"/>
        </FrameLayout>
        <!--  Verse text  -->
        <TextView android:id="@+id/tvVerseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ" android:textSize="28sp" android:textColor="@color/white" android:gravity="center" android:lineSpacingMultiplier="1.5" android:fontFamily="serif"/>
        <ImageView
            android:id="@+id/imgPageHifz"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:visibility="gone"/>
        <!--  Audio indicator  -->
        <LinearLayout android:id="@+id/llAudioIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔊" android:textSize="20sp" android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <!--  Repeat card  -->
    <LinearLayout android:id="@+id/llRepeatCard" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_rounded_card" android:gravity="center" android:padding="18dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp" app:layout_constraintTop_toBottomOf="@id/llVerseCard" app:layout_constraintBottom_toTopOf="@id/llPlayControls" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="التكرار" android:textSize="16sp" android:textColor="@color/white" android:textStyle="bold"/>
        <!--  Stars for repetition progress  -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:id="@+id/tvRepStar1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textSize="30sp" android:textColor="#555588" android:layout_marginHorizontal="4dp"/>
            <TextView android:id="@+id/tvRepStar2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textSize="30sp" android:textColor="#555588" android:layout_marginHorizontal="4dp"/>
            <TextView android:id="@+id/tvRepStar3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textSize="30sp" android:textColor="#555588" android:layout_marginHorizontal="4dp"/>
            <TextView android:id="@+id/tvRepStar4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textSize="30sp" android:textColor="#555588" android:layout_marginHorizontal="4dp"/>
            <TextView android:id="@+id/tvRepStar5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textSize="30sp" android:textColor="#555588" android:layout_marginHorizontal="4dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvRepProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 من 5" android:textSize="15sp" android:textColor="@color/yellow_main" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <!--  Play Controls  -->
    <LinearLayout android:id="@+id/llPlayControls" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="20dp" android:background="@color/nav_bar_bg" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <!--  Prev verse  -->
        <FrameLayout android:id="@+id/btnPrev" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_circle_purple_play" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏮" android:textSize="22sp" android:textColor="@color/white" android:layout_gravity="center"/>
        </FrameLayout>
        <!--  Play/Pause (big yellow)  -->
        <FrameLayout android:id="@+id/btnPlayPause" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_circle_yellow" android:clickable="true" android:focusable="true" android:layout_marginHorizontal="16dp" android:elevation="4dp">
            <TextView android:id="@+id/tvPlayPauseIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textSize="28sp" android:textColor="#09092B" android:layout_gravity="center"/>
        </FrameLayout>
        <!--  Repeat current  -->
        <FrameLayout android:id="@+id/btnRepeat" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_circle_purple_play" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔄" android:textSize="22sp" android:layout_gravity="center"/>
        </FrameLayout>
        <!--  Next verse  -->
        <FrameLayout android:id="@+id/btnNext" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_circle_purple_play" android:clickable="true" android:focusable="true" android:layout_marginStart="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏭" android:textSize="22sp" android:textColor="@color/white" android:layout_gravity="center"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>